<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Phase-3 scheduled executor (agentic-execution spec §C5).
     ACTIVATION IS DOM'S ACTION, never Claude's:
       cp launchd/com.dom.aistocks.executor.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.dom.aistocks.executor.plist
     Deactivate (the rollback lever):
       launchctl unload ~/Library/LaunchAgents/com.dom.aistocks.executor.plist
     Runs weekdays 06:35 PT (5 min after NYSE open). Logs land inside the
     gitignored privacy boundary. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dom.aistocks.executor</string>
  <!-- caffeinate (-s system, -i idle) holds the machine awake for the run.
       Without it the job fired during DarkWake and the Mac returned to sleep
       ~2s later, before DNS was usable: 2026-08-12..14 every scheduled recon
       and benchmark fetch failed with Errno 8 while attended runs worked.
       On battery, Power Nap can still restrict network in DarkWake — for a
       hard guarantee also schedule a real wake (Dom, needs sudo):
         sudo pmset repeat wakeorpoweron MTWRF 06:30:00 -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
    <string>-i</string>
    <string>/opt/homebrew/bin/python3</string>
    <string>scripts/executor_cron.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/dom/Desktop/ai-stocks</string>
  <key>StartCalendarInterval</key>
  <array>
    <!-- open-mode 06:35 PT: ticket-gen → execute → recon -->
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>35</integer></dict>
    <!-- close-mode 13:35 PT (16:35 ET, post-close): series + push → recon -->
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>35</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/dom/Desktop/ai-stocks/tracking/live/cron-executor.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dom/Desktop/ai-stocks/tracking/live/cron-executor.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
