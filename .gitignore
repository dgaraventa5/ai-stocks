# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# IDE
.vscode/
.idea/

# Cache
.cache/

# Claude Code session state
.remember/

# Backups (keep originals, not dated backups)
*.bak-*

# Excel lock files
~$*
.superpowers/
site/data/

# Wrangler local dev cache
.wrangler/

# Live-trading privacy boundary (agentic-execution spec §E, CLAUDE.md rule 29):
# tickets, receipts, recon snapshots, executor config — real dollars, share
# counts, account numbers, order IDs. NEVER commit anything under here.
tracking/live/

# earnings sentinel machine-local state (spec 2026-08-13)
tracking/earnings-sentinel-state.json

# Generated chart artifacts (backtest / perf-vs-benchmarks PNGs) — regenerable,
# not source of truth; the series JSON + site exporter are.
tracking/*.png

# macOS/iCloud sync-conflict duplicate copies ("name 2.ext") — never commit
# (150 appeared 2026-08-04 during parallel local/cloud sessions; all were byte-identical dupes)
* 2.*

# Empty marker file that tells macOS Spotlight to skip indexing this folder.
# Machine-local (it only matters on the Mac it sits on), so it is not committed.
# Related: the privacy test reads all ~1,100 tracked files, and on an
# iCloud-synced Desktop that took 1350s cold vs 6.15s warm (2026-08-27/28).
.metadata_never_index
